  "templates": [
    {
      "template_id": "RPT-TPL-APR-INSTALL",
      "template_type": "maintenance_installation_report",
      "title": "Sensor Processing Rack Installation / Corrective Maintenance Report",
      "revision": "A",
      "applicable_system_types": ["sensor_processing_rack"],
      "applicable_task_types": ["installation", "corrective_maintenance"],
      "applicable_models": ["APR-220", "APR-180"],
      "purpose": "Capture a synthetic record of module installation or corrective maintenance, including configuration applicability, procedure evidence, physical checks and release for post-maintenance test.",
      "prefill_fields": [
        "platform_id",
        "platform_name",
        "compartment_id",
        "compartment_name",
        "system_id",
        "system_name",
        "system_model",
        "system_configuration_revision",
        "software_revision",
        "task_id",
        "task_title",
        "task_type",
        "required_information_object_ids",
        "applicable_document_set",
        "known_config_issue_description"
      ],
      "required_fields": [
        "completed_by",
        "completion_date",
        "procedure_revision_used",
        "installed_or_replaced_item_identifier",
        "configuration_revision_confirmed",
        "work_summary",
        "checklist_status",
        "deviations",
        "release_decision"
      ],
      "checklist_items": [
        {
          "checklist_item_id": "APR-INST-01",
          "text": "Confirm platform, compartment, system model and configuration revision before starting work.",
          "required": true,
          "evidence_type": "record_reference",
          "related_rule_id": "CFG-RULE-008"
        },
        {
          "checklist_item_id": "APR-INST-02",
          "text": "Confirm the selected installation procedure and drawing are applicable to the installed configuration revision.",
          "required": true,
          "evidence_type": "information_object_ids",
          "related_rule_id": "CFG-RULE-001"
        },
        {
          "checklist_item_id": "APR-INST-03",
          "text": "Verify isolation, ESD protection and lifting-plan requirements before module handling.",
          "required": true,
          "evidence_type": "operator_confirmation",
          "related_information_object_id": "INFO-SAFETY-SENSOR-BAY-01"
        },
        {
          "checklist_item_id": "APR-INST-04",
          "text": "Record installed or replaced module identifier and relevant traceability information.",
          "required": true,
          "evidence_type": "free_text"
        },
        {
          "checklist_item_id": "APR-INST-05",
          "text": "Record bracket type, harness route and mounting-torque value from the applicable synthetic procedure.",
          "required": true,
          "evidence_type": "structured_measurement",
          "related_information_object_id": "INFO-APR-INST-REV-D"
        },
        {
          "checklist_item_id": "APR-INST-06",
          "text": "Confirm cooling-line clearance and visible strain relief after installation.",
          "required": true,
          "evidence_type": "operator_confirmation"
        },
        {
          "checklist_item_id": "APR-INST-07",
          "text": "Create or link the mandatory post-maintenance test task before releasing the system.",
          "required": true,
          "evidence_type": "linked_task_id",
          "related_rule_id": "CFG-RULE-002"
        }
      ],
      "free_text_fields": [
        {"field_id": "work_summary", "label": "Work performed", "required": true},
        {"field_id": "deviations", "label": "Deviations and observations", "required": true},
        {"field_id": "recommendations", "label": "Recommendations or follow-up actions", "required": false}
      ],
      "required_attachments": [
        "applicable_procedure_reference",
        "configuration_evidence",
        "post_maintenance_test_reference"
      ],
      "release_options": ["released_for_post_maintenance_test", "blocked_pending_deviation", "engineering_review_required"],
      "required_signoff_roles": ["qualified_technician", "configuration_controller"],
      "validation_rules": [
        "Selected procedure revision must be applicable to system configuration revision.",
        "Release cannot be final return-to-service; mandatory post-maintenance test remains required.",
        "All required checklist items must have a status and evidence reference."
      ]
    },
    {
