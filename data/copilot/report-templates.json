      "required_attachments": ["inspection_procedure_reference", "finding_evidence_or_note"],
      "release_options": ["released_for_functional_test", "corrective_action_required", "blocked_pending_finding_review"],
      "required_signoff_roles": ["qualified_inspector"],
      "validation_rules": [
        "A CDU-90 clearance below synthetic 40 mm requires corrective rework and functional verification.",
        "A functional test cannot be released while a blocking inspection finding remains open.",
        "All listed findings require a disposition."
