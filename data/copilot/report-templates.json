      "checklist_items": [
        {
          "checklist_item_id": "INSP-01",
          "text": "Confirm safe access conditions, applicable isolation and required personal-protection controls.",
          "required": true,
          "evidence_type": "operator_confirmation",
          "related_information_object_id": "INFO-SAFETY-MACHINERY-01"
        },
        {
          "checklist_item_id": "INSP-02",
          "text": "Confirm the inspection procedure is applicable to the selected system model and configuration revision.",
          "required": true,
          "evidence_type": "information_object_ids",
          "related_rule_id": "CFG-RULE-008"
        },
        {
          "checklist_item_id": "INSP-03",
          "text": "Inspect mounting condition, line supports, visible connectors and access to local isolation or service panels.",
          "required": true,
          "evidence_type": "operator_confirmation"
        },
        {
          "checklist_item_id": "INSP-04",
          "text": "For CDU-90, record the measured synthetic cooling-line clearance from the adjacent cable route.",
          "required": false,
          "evidence_type": "structured_measurement",
          "measurement_field": "cooling_line_clearance_mm",
          "related_rule_id": "CFG-RULE-006"
